{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "scaffold-eth-extension/extension/packages/nextjs/utils/sato/*.ts",
    "cloudflare-agents-x402/src/guard.ts",
    "agentkit-example/typescript/examples/langchain-sato-kit-chatbot/sato.ts"
  ]
}
