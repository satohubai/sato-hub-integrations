{
  "name": "@satohub/kit",
  "version": "0.1.0",
  "mcpName": "ai.satohub/kit",
  "description": "Sato Kit: prepare -> execute for onchain agent actions, with a policy pre-flight, pluggable signers and a hash-chained receipt log. Preview, unpublished.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "default": "./dist/spec/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "default": "./dist/policy/index.js"
    },
    "./signers": {
      "types": "./dist/signers/index.d.ts",
      "default": "./dist/signers/index.js"
    },
    "./intent": {
      "types": "./dist/intent/index.d.ts",
      "default": "./dist/intent/index.js"
    },
    "./receipts": {
      "types": "./dist/receipts/index.d.ts",
      "default": "./dist/receipts/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "default": "./dist/adapters/ai-sdk.js"
    },
    "./agentkit": {
      "types": "./dist/adapters/agentkit.d.ts",
      "default": "./dist/adapters/agentkit.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/adapters/claude-agent-sdk.d.ts",
      "default": "./dist/adapters/claude-agent-sdk.js"
    },
    "./openai-agents": {
      "types": "./dist/adapters/openai-agents.d.ts",
      "default": "./dist/adapters/openai-agents.js"
    },
    "./eliza": {
      "types": "./dist/adapters/eliza.d.ts",
      "default": "./dist/adapters/eliza.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "default": "./dist/adapters/langchain.js"
    },
    "./sato-os": {
      "types": "./dist/sato-os/index.d.ts",
      "default": "./dist/sato-os/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skill",
    "server.json",
    "llms-install.md",
    "context7.json",
    "gemini-extension.json",
    ".mcp.json",
    ".claude-plugin",
    ".codex-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satohubai/sato-hub-integrations.git",
    "directory": "packages/kit"
  },
  "homepage": "https://satohub.ai",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3",
    "@coinbase/agentkit": ">=0.10",
    "@coinbase/cdp-sdk": "*",
    "@x402/fetch": "*",
    "ai": "^7",
    "viem": "^2",
    "@openai/agents": ">=0.18",
    "@elizaos/core": "^1.7",
    "@langchain/core": ">=0.3"
  },
  "peerDependenciesMeta": {
    "@x402/fetch": {
      "optional": true
    },
    "@coinbase/cdp-sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@coinbase/agentkit": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@elizaos/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@coinbase/agentkit": "0.10.4",
    "@elizaos/core": "1.7.2",
    "@langchain/core": "1.2.13",
    "@openai/agents": "0.18.0",
    "@types/node": "^22.7.5",
    "ai": "7.0.116",
    "fast-check": "4.10.2",
    "typescript": "^5.6.3",
    "viem": "2.56.9"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sato-kit": "dist/cli/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  }
}
