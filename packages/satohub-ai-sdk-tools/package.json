{
  "name": "satohub-ai-sdk-tools",
  "version": "0.1.1",
  "description": "Vercel AI SDK tools for Sato Hub: search the scored onchain-agent index, run a Preflight check before installing or trading, get a swap-venue recommendation with the fee disclosed, and turn a goal into a build plan of real listings. Read-only and non-custodial.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "tools",
    "satohub",
    "onchain-agents",
    "crypto",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satohubai/sato-hub-integrations.git",
    "directory": "packages/satohub-ai-sdk-tools"
  },
  "homepage": "https://satohub.ai/mcp",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "dependencies": {
    "satohub-core": "^0.1.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "ai": "^5.0.0",
    "typescript": "^5.6.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
