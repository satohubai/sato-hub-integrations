{
  "name": "create-sato-agent",
  "version": "0.1.1",
  "description": "Create a runnable onchain agent repo from a nightly-checked Sato Hub template. Works as `npm create sato-agent`.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-sato-agent": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "satohub",
    "onchain-agents",
    "create",
    "scaffold",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satohubai/sato-hub-integrations.git",
    "directory": "packages/create-sato-agent"
  },
  "homepage": "https://satohub.ai/status",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
